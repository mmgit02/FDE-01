{
  "name": "gr-automation-demo",
  "version": "1.1.0",
  "description": "GR Automation: delivery note PDF -> PO match in S/4HANA -> goods receipt (101)",
  "engines": { "node": "22.x" },
  "scripts": {
    "start": "cds-serve",
    "dev": "cds-serve",
    "test": "node --test test/"
  },
  "dependencies": {
    "@sap-cloud-sdk/http-client": "^4",
    "@sap/cds": "^8",
    "@sap/xssec": "^3",
    "express": "^4",
    "passport": "^0.7",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@sap/cds-dk": "^8"
  },
  "cds": {
    "requires": {
      "auth": {
        "[production]": { "kind": "xsuaa" },
        "[development]": { "kind": "mocked" }
      }
    },
    "server": {
      "body_parser": { "limit": "15mb" }
    }
  }
}
